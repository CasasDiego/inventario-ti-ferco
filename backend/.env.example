# Copiar a .env y completar
JIRA_URL=https://ferco-medical.atlassian.net
JIRA_EMAIL=
JIRA_TOKEN=
JIRA_WORKSPACE_ID=

# Vacío = SQLite local en instance/jira_assets.db
# Producción: postgresql://usuario:clave@host/db?sslmode=require (Neon/Supabase)
DATABASE_URL=

SECRET_KEY=
# 1 en producción (HTTPS)
SESSION_COOKIE_SECURE=0
# Solo se usa si el usuario admin aún no existe en la base
# Contraseña de la única cuenta (dcasas@ferco-medical.com). Si se define, reemplaza la guardada al arrancar.
ADMIN_PASSWORD=

CORS_ORIGINS=http://localhost:3000
